#!/bin/sh
# Sample pre-commit hook. When a staged change touches the configuration or a pipeline, it
#   1. runs the offline validator, so a broken token or duplicate key never reaches the pipeline;
#   2. regenerates the pipeline variables of the affected pipelines, and stops the commit when
#      that changed a file, so you review the result and stage it yourself.
#
# Enable it once per clone:   git config core.hooksPath .githooks
# Skip it for one commit:     git commit --no-verify
#
# It works on the working tree, not only the staged content; the pipeline checks again.

changed=$(git diff --cached --name-only --diff-filter=ACMRD -- \
    'app-configuration/apps/' \
    'app-configuration/variables/' \
    'app-configuration/schemas/' \
    'app-configuration/lib/' \
    'app-configuration/New-PipelineVariables.ps1' \
    'pipelines/')

if [ -z "$changed" ]; then
    exit 0
fi

if ! command -v pwsh >/dev/null 2>&1; then
    echo "pre-commit: pwsh (PowerShell 7.2+) not found; skipping the App Configuration checks." >&2
    exit 0
fi

echo "pre-commit: validating App Configuration files..."
if ! pwsh -NoProfile -NonInteractive -File app-configuration/Test-AppConfiguration.ps1; then
    echo "pre-commit: fix the errors above, or commit with --no-verify to skip this check." >&2
    exit 1
fi

echo "pre-commit: regenerating pipeline variables for the changed files..."
staged=$(printf '%s\n' "$changed" | tr '\n' ',')
if ! pwsh -NoProfile -NonInteractive -File app-configuration/New-PipelineVariables.ps1 -StagedFiles "$staged"; then
    echo "pre-commit: the generator failed; fix the errors above." >&2
    exit 1
fi

# Generated files that differ from what is staged: modified, deleted or new.
pending=$( (git diff --name-only -- 'pipelines/variables/'; \
            git ls-files --others --exclude-standard -- 'pipelines/variables/') | sort -u)
if [ -n "$pending" ]; then
    echo "pre-commit: the generated pipeline variables changed:" >&2
    printf '  %s\n' $pending >&2
    echo "pre-commit: review them, run 'git add pipelines/variables' and commit again." >&2
    exit 1
fi
